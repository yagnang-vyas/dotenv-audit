# Synthetic values only. Every line here is parsed identically by dotenv.

PLAIN=hello
export EXPORTED=fake-exported-value
  SPACED  =  spaced value  
EQUALS=b=c==
DOTTED.KEY-NAME=1
_UNDERSCORE=1
INLINE=value # a comment
EMPTY=
EMPTY_DOUBLE=""
EMPTY_SINGLE=''
SINGLE='single $literal'
DOUBLE="double # not a comment" # comment
DOUBLE_NEWLINE="line1\nline2"
BACKTICK=`it's "quoted"`
UNQUOTED_QUOTES=x"y
REFERENCE=${PLAIN}
MULTI="first
second
third"
MULTI_SINGLE='a
b'
URL=postgres://fake-user:fake-pass@localhost:5432/fake_db
UNICODE=héllo wörld
DUPLICATE=first
DUPLICATE=second
PADDED="  padded  "
